# Copy this file to ".env" and change values if you want. Every line is optional.

# Port the website runs on
PORT=3000

# After a connection drops, how long (ms) the server waits for the person to
# come back before removing them and moving the host role to someone else.
# Use 0 to transfer host immediately.
GRACE_MS=5000

# Throttle: max updates one connection may send per second (extra ones are dropped)
MAX_UPDATES_PER_SEC=5

# Where rooms are saved so they survive restarts (default: data/rooms.json)
# DATA_FILE=./data/rooms.json
